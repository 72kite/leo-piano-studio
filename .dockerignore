# node_modules is installed fresh inside the image via `npm ci` — copying
# the host's copy on top would overwrite Linux-built native binaries
# (esbuild, rollup, etc.) with whatever platform the host used.
node_modules/
npm-debug.log*

# build output — regenerated by `npm run build` inside the image
dist/
build/

.git/
.gitignore
.dockerignore

.vscode/
.idea/

.env
.env.local
.env.*.local

# docs / non-runtime files
README.md
ROADMAP.md

# test-only files never needed at runtime
coverage/
**/*.test.js
src/test/

.DS_Store
Thumbs.db
