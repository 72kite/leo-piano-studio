# Copy to .env and fill in real values before running the server.
# Never commit the resulting .env file.

# Required in production — 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3001
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API. Must
# match the browser's Origin header exactly — which omits the port when
# it's the scheme's default (80 for http, 443 for https). A frontend
# served plainly on :80, e.g. via the docker-compose nginx container,
# sends "http://localhost", not "http://localhost:80".
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Access tokens: client treats a token as fresh for 14 minutes, so this must
# stay above that. Refresh tokens: how long an unused session stays valid.
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Requests per IP per window on /api/auth/* (register/login/refresh).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Requests per IP per minute across the whole /api surface.
GLOBAL_RATE_LIMIT_MAX=120

# Where the JSON-file datastore lives. Defaults to server/data/db.json.
# Ignored entirely if DATABASE_URL is set (see below).
DB_FILE=

# Players per race lobby (matchmaking waits for this many before starting).
RACE_LOBBY_SIZE=4

# Players per MIDI Race lobby (proficiency-based piano race — see
# server/midirace/). Kept small by default: unlike typing race, every player
# needs a real MIDI keyboard or the on-screen fallback, so a big lobby is a
# lot to expect to actually fill.
MIDI_RACE_LOBBY_SIZE=2

# Leave unset to keep the zero-config JSON-file store (DB_FILE above). Set
# this to switch the backend to PostgreSQL instead (server/lib/pgDb.js) —
# e.g. postgres://leo:yourpassword@postgres:5432/leo when using the
# `postgres` service in docker-compose.yml (bring it up with
# `docker compose --profile postgres up -d`). Existing JSON data is NOT
# migrated automatically — see server/scripts/migrate-json-to-pg.js.
DATABASE_URL=

# Only read by docker-compose, only if you're using the `postgres` profile
# above — the actual Postgres container's own credentials.
POSTGRES_DB=leo
POSTGRES_USER=leo
POSTGRES_PASSWORD=

# Read by docker-compose (not the server itself) as a build ARG for the
# leo-app frontend image — baked into the JS bundle at build time, since
# it's a static site served by nginx with no server-side runtime to read
# env vars from. Only needs setting if the API won't be reachable at
# localhost:3001 from wherever the browser loads the page (e.g. deploying
# the two containers to different hosts instead of one docker-compose
# stack). Leave unset for the default single-host setup.
VITE_API_URL=
